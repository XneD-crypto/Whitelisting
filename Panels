local ALLOWED_HWIDS = {}
local function loadAllowedList()
    local ok, raw = pcall(function()
        return game:HttpGet(HWID_LIST_URL, true)
    end)
    if not ok or not raw or #raw < 2 then
        warn("[Whitelist] Не удалось загрузить список HWID с GitHub")
        return false
    end
    local decodeOk, decoded = pcall(function()
        return HttpService:JSONDecode(raw)
    end)
    if not decodeOk or type(decoded) ~= "table" then
        warn("[Whitelist] Ошибка парсинга JSON")
        return false
    end
    for _, id in ipairs(decoded) do
        if type(id) == "string" and #id > 0 then
            ALLOWED_HWIDS[id] = true
        end
    end
    return true
end
