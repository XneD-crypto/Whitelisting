local function getRealHWID()
    if gethwid then
        local ok, id = pcall(gethwid)
        if ok and id and id ~= "" then return tostring(id) end
    end
    if delta then
        if delta.gethwid then
            local ok, id = pcall(delta.gethwid)
            if ok and id then return tostring(id) end
        end
        if delta.HWID then return tostring(delta.HWID) end
    end
    if fluxus then
        if fluxus.gethwid then
            local ok, id = pcall(fluxus.gethwid)
            if ok and id then return tostring(id) end
        end
        if fluxus.HWID then return tostring(fluxus.HWID) end
    end
    if Arceus then
        if Arceus.gethwid then
            local ok, id = pcall(Arceus.gethwid)
            if ok and id then return tostring(id) end
        end
        if Arceus.HWID then return tostring(Arceus.HWID) end
    end
    if hydrogen then
        if hydrogen.gethwid then
            local ok, id = pcall(hydrogen.gethwid)
            if ok and id then return tostring(id) end
        end
        if hydrogen.HWID then return tostring(hydrogen.HWID) end
    end
    if codex then
        if codex.gethwid then
            local ok, id = pcall(codex.gethwid)
            if ok and id then return tostring(id) end
        end
        if codex.HWID then return tostring(codex.HWID) end
    end
    if syn then
        if syn.gethwid then
            local ok, id = pcall(syn.gethwid)
            if ok and id then return tostring(id) end
        end
        if syn.HWID then return tostring(syn.HWID) end
    end
    if secure_load then
        local ok, id = pcall(secure_load, "return gethwid()")
        if ok and id then return tostring(id) end
    end
    local env = getgenv and getgenv() or _G
    if env.gethwid then
        local ok, id = pcall(env.gethwid)
        if ok and id then return tostring(id) end
    end
    local ok, id = pcall(function()
        return game:GetService("RbxAnalyticsService"):GetClientId()
    end)
    if ok and id then return tostring(id) end
    return nil
end

local MY_HWID = getRealHWID()
